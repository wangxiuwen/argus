#!/bin/zsh
# argus — manage a local mlx-vlm OpenAI-compatible server (Apple Silicon / MLX)
# Config: ~/.config/argus/config  (KEY=VALUE, see `argus config`)

CONFIG_DIR="$HOME/.config/argus"
CONFIG="$CONFIG_DIR/config"
HOST=""  # zsh preloads $HOST with the machine hostname; clear it so the default below wins
[[ -f "$CONFIG" ]] && source "$CONFIG"

MODEL="${MODEL:-mlx-community/Qwen3.8-27B-bf16}"
PORT="${PORT:-8090}"
HOST="${HOST:-127.0.0.1}"
UI_PORT="${UI_PORT:-8091}"
EXTRA_ARGS="${EXTRA_ARGS:-}"

PIDFILE="$HOME/.local/state/argus/server.pid"
UI_PIDFILE="$HOME/.local/state/argus/ui.pid"
LOG="$HOME/Library/Logs/argus.log"
SERVER="$HOME/.local/bin/mlx_vlm.server"
SHARE="$HOME/.local/share/argus"
mkdir -p "$(dirname "$PIDFILE")" "$CONFIG_DIR"

is_running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

is_ready() {
  curl -s -m 2 "http://$HOST:$PORT/v1/models" >/dev/null 2>&1
}

cmd_start() {
  if is_running; then echo "already running (pid $(cat "$PIDFILE"), http://$HOST:$PORT)"; return 0; fi
  if [[ ! -x "$SERVER" ]] && ! command -v mlx_vlm.server >/dev/null; then
    echo "mlx_vlm.server not found. Install it with:"
    echo "  uv tool install -p 3.12 mlx-vlm    # or: pip install mlx-vlm"
    return 1
  fi
  [[ -x "$SERVER" ]] || SERVER="$(command -v mlx_vlm.server)"
  echo "starting $MODEL on http://$HOST:$PORT"
  echo "(first run downloads the model from Hugging Face automatically)"
  nohup "$SERVER" --model "$MODEL" --host "$HOST" --port "$PORT" ${=EXTRA_ARGS} >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  echo "pid $!  log: $LOG"
}

cmd_stop() {
  if is_running; then
    kill "$(cat "$PIDFILE")" && rm -f "$PIDFILE"
    echo "stopped"
  else
    rm -f "$PIDFILE"
    echo "not running"
  fi
}

cmd_status() {
  if is_ready; then
    echo "ready: http://$HOST:$PORT  model: $MODEL"
  elif is_running; then
    echo "loading (pid $(cat "$PIDFILE")) — model is being loaded/downloaded, see: argus log"
  else
    echo "not running"
  fi
}

cmd_download() {
  if command -v hf >/dev/null; then
    hf download "$MODEL"
  elif command -v huggingface-cli >/dev/null; then
    huggingface-cli download "$MODEL"
  else
    echo "hf CLI not found. Install with: pip install -U huggingface_hub"
    return 1
  fi
}

cmd_model() {
  if [[ -z "$1" ]]; then
    echo "current model: $MODEL"
    echo "usage: argus model <huggingface-repo-id>   # e.g. mlx-community/Qwen3.8-27B-8bit"
    return 0
  fi
  mkdir -p "$CONFIG_DIR"
  touch "$CONFIG"
  if grep -q '^MODEL=' "$CONFIG" 2>/dev/null; then
    sed -i '' "s|^MODEL=.*|MODEL=$1|" "$CONFIG"
  else
    echo "MODEL=$1" >> "$CONFIG"
  fi
  echo "model set to $1 (restart to apply: argus restart)"
}

cmd_config() {
  echo "config file: $CONFIG"
  echo "----"
  cat "$CONFIG" 2>/dev/null || echo "(empty — defaults in use)"
  echo "----"
  echo "effective: MODEL=$MODEL PORT=$PORT HOST=$HOST EXTRA_ARGS=$EXTRA_ARGS"
}

ui_running() {
  [[ -f "$UI_PIDFILE" ]] && kill -0 "$(cat "$UI_PIDFILE")" 2>/dev/null
}

cmd_ui() {
  if [[ "$1" == "stop" ]]; then
    if ui_running; then kill "$(cat "$UI_PIDFILE")"; rm -f "$UI_PIDFILE"; echo "UI stopped"; else echo "UI not running"; fi
    return 0
  fi
  if ! ui_running; then
    ARGUS_API="http://$HOST:$PORT" ARGUS_UI_PORT="$UI_PORT" nohup python3 "$SHARE/ui.py" >> "$LOG" 2>&1 &
    echo $! > "$UI_PIDFILE"
    sleep 0.5
  fi
  echo "UI: http://127.0.0.1:$UI_PORT"
  # "start" boots the UI server without opening a browser (used by the app's chat window)
  [[ "$1" == "start" ]] || open "http://127.0.0.1:$UI_PORT" 2>/dev/null
}

case "$1" in
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_stop; sleep 1; cmd_start ;;
  status)   cmd_status ;;
  log)      touch "$LOG"; tail -f "$LOG" ;;
  download) cmd_download ;;
  model)    cmd_model "$2" ;;
  use)      [[ -n "$2" ]] || { echo "usage: argus use <huggingface-repo-id>"; exit 1; }
            cmd_model "$2"; cmd_stop; sleep 1; MODEL="$2"; cmd_start ;;
  config)   cmd_config ;;
  ask)      shift; ARGUS_API="http://$HOST:$PORT" exec python3 "$SHARE/chat.py" ask "$@" ;;
  chat)     ARGUS_API="http://$HOST:$PORT" exec python3 "$SHARE/chat.py" chat ;;
  ui)       cmd_ui "$2" ;;
  *)
    cat <<'EOF'
argus — local vision-language model, menu bar + CLI

server:
  argus start       start the server (auto-downloads model on first run)
  argus stop        stop the server
  argus restart     restart the server
  argus status      ready / loading / not running
  argus log         tail the server log

chat:
  argus ask "prompt" [image.png ...]   one-shot question, images optional
  argus chat                           interactive chat (drop image paths in)
  argus ui                             open the web chat UI (paste/drop images)
  argus ui stop                        stop the web UI

model:
  argus use <id>    switch model and restart the server (e.g. a 4bit/8bit variant)
  argus model [id]  show or set the model without restarting
  argus download    pre-download the configured model
  argus config      show config file and effective settings
EOF
    ;;
esac
