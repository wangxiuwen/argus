#!/bin/zsh
# argus — manage a local mlx-vlm OpenAI-compatible server (Apple Silicon / MLX)
# Config: ~/.config/argus/config  (KEY=VALUE, see `argus config`)

CONFIG_DIR="$HOME/.config/argus"
CONFIG="$CONFIG_DIR/config"

# Parse data as data.  Sourcing the config would execute shell syntax embedded
# in a model id or EXTRA_ARGS, and a malformed hand-edited file could run
# arbitrary commands whenever Argus starts.
MODEL="" PORT="" HOST="" UI_PORT="" BRIDGE_PORT="" MAX_TOKENS="" EXTRA_ARGS=""
if [[ -f "$CONFIG" ]]; then
  while IFS='=' read -r task_key task_value; do
    case "$task_key" in
      MODEL)       MODEL="$task_value" ;;
      PORT)        PORT="$task_value" ;;
      HOST)        HOST="$task_value" ;;
      UI_PORT)     UI_PORT="$task_value" ;;
      BRIDGE_PORT) BRIDGE_PORT="$task_value" ;;
      MAX_TOKENS)  MAX_TOKENS="$task_value" ;;
      EXTRA_ARGS)  EXTRA_ARGS="$task_value" ;;
    esac
  done < "$CONFIG"
fi

MODEL="${MODEL:-mlx-community/Qwen3.8-27B-bf16}"
PORT="${PORT:-8090}"
HOST="${HOST:-127.0.0.1}"
UI_PORT="${UI_PORT:-8091}"
BRIDGE_PORT="${BRIDGE_PORT:-8092}"
if [[ -z "$MAX_TOKENS" && "$EXTRA_ARGS" =~ '--max-tokens(=|[[:space:]]+)([0-9]+)' ]]; then
  MAX_TOKENS="${match[2]}"
fi
MAX_TOKENS="${MAX_TOKENS:-4096}"
EXTRA_ARGS="${EXTRA_ARGS:-}"

[[ "$PORT" == <-> && "$PORT" -ge 1024 && "$PORT" -le 65535 ]] || PORT=8090
[[ "$UI_PORT" == <-> && "$UI_PORT" -ge 1024 && "$UI_PORT" -le 65535 ]] || UI_PORT=8091
[[ "$BRIDGE_PORT" == <-> && "$BRIDGE_PORT" -ge 1024 && "$BRIDGE_PORT" -le 65535 ]] || BRIDGE_PORT=8092
[[ "$MAX_TOKENS" == <-> && "$MAX_TOKENS" -ge 128 && "$MAX_TOKENS" -le 131072 ]] || MAX_TOKENS=4096
[[ "$HOST" == "127.0.0.1" || "$HOST" == "0.0.0.0" ]] || HOST=127.0.0.1
CONNECT_HOST="$HOST"
[[ "$CONNECT_HOST" == "0.0.0.0" ]] && CONNECT_HOST="127.0.0.1"

PIDFILE="$HOME/.local/state/argus/server.pid"
UI_PIDFILE="$HOME/.local/state/argus/ui.pid"
BRIDGE_PIDFILE="$HOME/.local/state/argus/bridge.pid"
LOG="$HOME/Library/Logs/argus.log"
SERVER="$HOME/.local/bin/mlx_vlm.server"
SHARE="$HOME/.local/share/argus"
mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOG")" "$CONFIG_DIR"

spawn_detached() {
  # start_new_session is stronger than shell `nohup &`: it survives callers
  # that tear down their entire terminal/process session after this command.
  python3 -c '
import subprocess, sys
log = open(sys.argv[1], "ab", buffering=0)
process = subprocess.Popen(
    sys.argv[2:], stdin=subprocess.DEVNULL, stdout=log,
    stderr=subprocess.STDOUT, start_new_session=True, close_fds=True)
print(process.pid)
' "$LOG" "$@"
}

process_matches() {
  local pid="$1" needle="$2"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && \
    ps -p "$pid" -o command= 2>/dev/null | grep -Fq -- "$needle"
}

listener_pid() {
  local port="$1" needle="$2" pid
  pid="$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -n 1)"
  process_matches "$pid" "$needle" || return 1
  echo "$pid"
}

pid_listens() {
  local pid="$1" port="$2"
  [[ -n "$pid" ]] && lsof -nP -a -p "$pid" -iTCP:"$port" -sTCP:LISTEN \
    >/dev/null 2>&1
}

server_pid() {
  local pid=""
  [[ -f "$PIDFILE" ]] && pid="$(cat "$PIDFILE")"
  if process_matches "$pid" "mlx_vlm.server"; then
    echo "$pid"
    return 0
  fi
  listener_pid "$PORT" "mlx_vlm.server"
}

is_running() {
  server_pid >/dev/null
}

port_in_use() {
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1
}

is_ready() {
  curl -s -m 2 "http://$CONNECT_HOST:$PORT/health" >/dev/null 2>&1
}

cmd_start() {
  local pid
  if pid="$(server_pid)"; then
    echo "$pid" > "$PIDFILE"
    echo "already running (pid $pid, http://$HOST:$PORT)"
    return 0
  fi
  if port_in_use; then
    echo "port $PORT is already owned by another process — stop it or choose another port"
    return 1
  fi
  if [[ ! -x "$SERVER" ]] && ! command -v mlx_vlm.server >/dev/null; then
    echo "mlx_vlm.server not found. Install it with:"
    echo "  uv tool install -p 3.12 mlx-vlm    # or: pip install mlx-vlm"
    return 1
  fi
  [[ -x "$SERVER" ]] || SERVER="$(command -v mlx_vlm.server)"
  echo "starting $MODEL on http://$HOST:$PORT"
  echo "(first run downloads the model from Hugging Face automatically)"
  pid="$(spawn_detached "$SERVER" --model "$MODEL" --host "$HOST" --port "$PORT" \
    --max-tokens "$MAX_TOKENS" ${=EXTRA_ARGS})" || return 1
  echo "$pid" > "$PIDFILE"
  sleep 0.3
  if ! process_matches "$pid" "mlx_vlm.server"; then
    rm -f "$PIDFILE"
    echo "server failed to start — see: argus log"
    return 1
  fi
  echo "pid $pid  log: $LOG"
}

cmd_stop() {
  local pid
  if ! pid="$(server_pid)"; then
    rm -f "$PIDFILE"
    echo "not running"
    return 0
  fi
  kill "$pid" 2>/dev/null
  # a server mid-generation can take a while to notice SIGTERM; wait it out, then force
  local i
  for i in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    sleep 1
  fi
  rm -f "$PIDFILE"
  # the listening socket can linger briefly after the process is gone
  for i in $(seq 1 20); do port_in_use || break; sleep 0.5; done
  echo "stopped"
}

cmd_status() {
  local actual_model
  actual_model="$(curl -s -m 2 "http://$CONNECT_HOST:$PORT/health" 2>/dev/null | \
    python3 -c 'import json,sys; print(json.load(sys.stdin).get("loaded_model") or "")' 2>/dev/null)"
  if [[ -n "$actual_model" ]]; then
    echo "ready: http://$CONNECT_HOST:$PORT  model: $actual_model"
  elif is_running; then
    echo "busy or loading (pid $(server_pid)) — see: argus log"
  else
    echo "not running"
  fi
}

cmd_download() {
  if command -v hf >/dev/null; then
    hf download "$MODEL"
  elif command -v huggingface-cli >/dev/null; then
    huggingface-cli download "$MODEL"
  else
    echo "hf CLI not found. Install with: pip install -U huggingface_hub"
    return 1
  fi
}

cmd_model() {
  if [[ -z "$1" ]]; then
    echo "current model: $MODEL"
    echo "usage: argus model <huggingface-repo-id>   # e.g. mlx-community/Qwen3.8-27B-8bit"
    return 0
  fi
  if [[ "$1" == *$'\n'* || "$1" == *$'\r'* || "$1" == *'='* ]]; then
    echo "invalid model id"
    return 1
  fi
  mkdir -p "$CONFIG_DIR"
  touch "$CONFIG"
  local temp_config line found=0
  temp_config="$(mktemp "$CONFIG_DIR/config.XXXXXX")" || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == MODEL=* ]]; then
      print -r -- "MODEL=$1" >> "$temp_config"
      found=1
    else
      print -r -- "$line" >> "$temp_config"
    fi
  done < "$CONFIG"
  (( found )) || print -r -- "MODEL=$1" >> "$temp_config"
  mv "$temp_config" "$CONFIG"
  echo "model set to $1 (restart to apply: argus restart)"
}

cmd_config() {
  echo "config file: $CONFIG"
  echo "----"
  cat "$CONFIG" 2>/dev/null || echo "(empty — defaults in use)"
  echo "----"
  echo "effective: MODEL=$MODEL PORT=$PORT HOST=$HOST UI_PORT=$UI_PORT BRIDGE_PORT=$BRIDGE_PORT MAX_TOKENS=$MAX_TOKENS EXTRA_ARGS=$EXTRA_ARGS"
}

ui_pid() {
  local pid=""
  [[ -f "$UI_PIDFILE" ]] && pid="$(cat "$UI_PIDFILE")"
  if process_matches "$pid" "$SHARE/ui.py"; then
    echo "$pid"
    return 0
  fi
  listener_pid "$UI_PORT" "$SHARE/ui.py"
}

ui_running() {
  ui_pid >/dev/null
}

stop_ui() {
  local pid
  if ! pid="$(ui_pid)"; then
    rm -f "$UI_PIDFILE"
    return 1
  fi
  kill "$pid" 2>/dev/null
  for _ in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  rm -f "$UI_PIDFILE"
  return 0
}

start_ui() {
  local pid
  if pid="$(ui_pid)"; then
    if pid_listens "$pid" "$UI_PORT"; then
      echo "$pid" > "$UI_PIDFILE"
      return 0
    fi
    # A saved UI_PORT takes effect the next time the app opens the UI, even if
    # the user chose Save rather than Save & Restart in the old UI process.
    stop_ui >/dev/null 2>&1 || true
  fi
  if lsof -nP -iTCP:"$UI_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "UI port $UI_PORT is already in use"
    return 1
  fi
  pid="$(spawn_detached env ARGUS_API="http://$CONNECT_HOST:$PORT" ARGUS_UI_PORT="$UI_PORT" \
    python3 "$SHARE/ui.py")" || return 1
  echo "$pid" > "$UI_PIDFILE"
  for _ in {1..20}; do
    if curl -s -m 1 "http://127.0.0.1:$UI_PORT/" >/dev/null 2>&1; then return 0; fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  rm -f "$UI_PIDFILE"
  echo "UI failed to start — see: argus log"
  return 1
}

cmd_ui() {
  case "$1" in
    stop)
      if stop_ui; then echo "UI stopped"; else echo "UI not running"; fi
      return 0 ;;
    restart)
      stop_ui >/dev/null 2>&1 || true
      start_ui || return 1 ;;
    *)
      start_ui || return 1 ;;
  esac
  echo "UI: http://127.0.0.1:$UI_PORT"
  # "start" boots the UI server without opening a browser (used by the app's chat window)
  [[ "$1" == "start" || "$1" == "restart" ]] || open "http://127.0.0.1:$UI_PORT" 2>/dev/null
}

bridge_pid() {
  local pid=""
  if [[ -f "$BRIDGE_PIDFILE" ]]; then
    pid="$(cat "$BRIDGE_PIDFILE")"
    if process_matches "$pid" "$SHARE/bridge.py"; then
      echo "$pid"
      return 0
    fi
  fi
  # Recover a bridge whose pidfile was lost, but never adopt an unrelated
  # process merely because it happens to own the configured port.
  listener_pid "$BRIDGE_PORT" "$SHARE/bridge.py"
}

bridge_running() {
  bridge_pid >/dev/null
}

cmd_bridge() {
  case "$1" in
    stop)
      local pid
      if pid="$(bridge_pid)"; then
        kill "$pid"
        for _ in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        rm -f "$BRIDGE_PIDFILE"
        echo "bridge stopped"
      else echo "bridge not running"; fi
      ;;
    status)
      if curl -s -m 2 "http://127.0.0.1:$BRIDGE_PORT/health" >/dev/null 2>&1; then
        echo "bridge ready: http://127.0.0.1:$BRIDGE_PORT (OpenAI + Anthropic)"
      else echo "bridge not running"; fi
      ;;
    *)
      local pid
      if pid="$(bridge_pid)"; then
        if pid_listens "$pid" "$BRIDGE_PORT"; then
          echo "$pid" > "$BRIDGE_PIDFILE"
          echo "bridge already running: http://127.0.0.1:$BRIDGE_PORT"
          return 0
        fi
        # Reconcile a saved BRIDGE_PORT when the old bridge is still alive.
        cmd_bridge stop >/dev/null || return 1
      fi
      pid="$(spawn_detached env ARGUS_API="http://$CONNECT_HOST:$PORT" ARGUS_MODEL="$MODEL" \
        ARGUS_BRIDGE_PORT="$BRIDGE_PORT" ARGUS_MAX_TOKENS="$MAX_TOKENS" \
        python3 "$SHARE/bridge.py")" || return 1
      echo "$pid" > "$BRIDGE_PIDFILE"
      sleep 0.6
      if kill -0 "$pid" 2>/dev/null && curl -s -m 2 "http://127.0.0.1:$BRIDGE_PORT/health" >/dev/null 2>&1; then
        echo "bridge on http://127.0.0.1:$BRIDGE_PORT (OpenAI + Anthropic → http://$HOST:$PORT)"
      else
        rm -f "$BRIDGE_PIDFILE"
        echo "bridge failed to start — see: argus log"
        return 1
      fi
      ;;
  esac
}

cmd_restart() {
  local had_ui=0 had_bridge=0
  ui_running && had_ui=1
  bridge_running && had_bridge=1
  if (( had_bridge )); then cmd_bridge stop >/dev/null; fi
  if (( had_ui )); then stop_ui >/dev/null 2>&1; fi
  cmd_stop || return 1
  cmd_start || return 1
  if (( had_ui )); then start_ui || return 1; fi
  if (( had_bridge )); then cmd_bridge start || return 1; fi
  return 0
}

case "$1" in
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_restart ;;
  status)   cmd_status ;;
  log)      touch "$LOG"; tail -f "$LOG" ;;
  download) cmd_download ;;
  model)    cmd_model "$2" ;;
  use)      [[ -n "$2" ]] || { echo "usage: argus use <huggingface-repo-id>"; exit 1; }
            cmd_model "$2" || exit 1
            cmd_stop || exit 1
            MODEL="$2"
            cmd_start ;;
  config)   cmd_config ;;
  ask)      shift; ARGUS_API="http://$CONNECT_HOST:$PORT" ARGUS_MODEL="$MODEL" \
              ARGUS_MAX_TOKENS="$MAX_TOKENS" \
              exec python3 "$SHARE/chat.py" ask "$@" ;;
  chat)     ARGUS_API="http://$CONNECT_HOST:$PORT" ARGUS_MODEL="$MODEL" \
              ARGUS_MAX_TOKENS="$MAX_TOKENS" \
              exec python3 "$SHARE/chat.py" chat ;;
  ui)       cmd_ui "$2" ;;
  prune)    shift; exec python3 "$SHARE/prune.py" "$@" ;;
  bridge)   cmd_bridge "$2" ;;
  launch)   shift; ARGUS_API="http://$CONNECT_HOST:$PORT" ARGUS_MODEL="$MODEL" \
              ARGUS_MAX_TOKENS="$MAX_TOKENS" \
              ARGUS_BRIDGE="http://127.0.0.1:$BRIDGE_PORT" \
              exec python3 "$SHARE/launch.py" "$@" ;;
  *)
    cat <<'EOF'
argus — local vision-language model, menu bar + CLI

server:
  argus start       start the server (auto-downloads model on first run)
  argus stop        stop the server
  argus restart     restart the server
  argus status      ready / loading / not running
  argus log         tail the server log

chat:
  argus ask "prompt" [image.png ...]   one-shot question, images optional
  argus chat                           interactive chat (drop image paths in)
  argus ui                             open the web chat UI (paste/drop images)
  argus ui stop                        stop the web UI
  argus ui restart                     restart the web UI without opening a browser

use it from other tools:
  argus launch                         list tools and whether they are installed
  argus launch codex|aider|opencode    run an OpenAI-protocol tool against Argus
  argus launch claude                  run Claude Code via the Anthropic bridge
  argus launch shell                   a shell with the API env already set
  argus bridge [stop|status]           the OpenAI + Anthropic compatibility endpoint

model:
  argus use <id>    switch model and restart the server (e.g. a 4bit/8bit variant)
  argus model [id]  show or set the model without restarting
  argus download    pre-download the configured model
  argus prune       delete abandoned partial downloads from the HF cache
  argus config      show config file and effective settings
EOF
    ;;
esac
